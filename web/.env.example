# Massive (formerly Polygon.io) — preferred source, full consolidated tape.
# POLYGON_API_KEY is accepted as an alias.
MASSIVE_API_KEY=

# Alpaca. Free plan is IEX-only. Use PAPER keys — data and trading keys are the
# same credential. ALPACA_KEY / ALPACA_SECRET are accepted as aliases.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
